# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# Environments
.env
.venv
venv/
ENV/
env/

# IDEs
.idea/
.vscode/

# macOS
.DS_Store

# Linters / type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json

# Serialized model artifacts (regenerable via `make backtest`)
*.pkl
*.joblib

# Local market-data cache (regenerable via `make data`)
data/cache/

# Note: reports/ (results.md + figures/) IS committed — it is the paper's evidence.

# LaTeX build intermediates (paper.pdf itself IS committed)
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# arXiv build staging; the tarball is committed, the scratch directory is not.
paper/arxiv/

# Goyal-Welch source archives: 28 MB each, re-downloadable from the links in
# audit/scripts/goyal_welch_pilot.py. The workbook the pilot actually reads is committed.
data/goyal_welch/*.zip.real
data/goyal_welch/gwz2025/
paper-equity/*.log
paper-equity/*.blg
paper-equity/*.aux
paper-equity/*.out
